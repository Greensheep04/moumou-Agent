# Copy this file to .env and fill in YOUR OWN key.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key, and never paste one into a
# commit message or an issue.

# Optional course gateway profile (select with --llm-profile hkgai).
DEEPSEEK_API_KEY=

# Key for the default DeepSeek official profile.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY_OFFICIAL=

# Which profile to use when --llm-profile is not passed: hkgai | deepseek
# MOUMOU_LLM_PROFILE=deepseek

# Course HKGAI configuration. For another assigned service, replace both values
# with its supplied model and OpenAI-compatible endpoint. The DEEPSEEK_* variable
# names are retained for the HKGAI adapter; they do not select an OpenAI service.
DEEPSEEK_MODEL=t2_hkgai-v3_fp8_1m_e7
DEEPSEEK_BASE_URL=https://api1.hkgai.net/v1
DEEPSEEK_TIMEOUT_S=180

# Optional web search.
# Loaded by the application/validation entrypoint, never stored in tool arguments.
MOUMOU_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Set MOUMOU_SEARCH_PROVIDER=serpapi to use SerpApi's Google Search API.
SERPAPI_API_KEY=

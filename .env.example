# Copy this file to .env and fill in YOUR OWN key.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key, and never paste one into a
# commit message or an issue.

# Required. Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional. Defaults below are the recommended settings.
# `deepseek-flash` is the stable id for DeepSeek-V4.1-Flash-1017.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_S=180
